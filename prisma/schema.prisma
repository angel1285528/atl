
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String     @id @unique @default(cuid())
  correo        String     @unique // Correo electrónico del usuario
  telefono      String?    @unique // Teléfono del usuario (opcional)
  password      String // Contraseña (hash)
  rol           RolUsuario @default(Admin) // Rol del usuario
  fechaCreacion DateTime   @default(now()) // Fecha de creación de la cuenta
  creadoPor     String // Quién creó la cuenta (solo para SuperAdmin)
  socioId       String? // ID del socio asociado (si el usuario es un socio)
  socio         socio?     @relation(fields: [socioId], references: [id])
}

model JornadaEntrenamiento {
  idJornadaEntrenamiento    Int            @id @default(autoincrement())
  fechaJornadaEntrenamiento DateTime
  horaInicioJornada         String?        @default("18:00:00")
  horaFinJornada            String?        @default("20:00:00")
  bitacoraJornada           String?
  estado                    EstadoJornada  @default(Programada)
  lugarJornada              String?
  clases                    JornadaClase[]
}

model Clases {
  idClase      String         @id @unique
  tipo         TipoClase
  estadoClase  Boolean        @default(true)
  asistencias  Asistencia[]
  jornadas     JornadaClase[]
  alumnos      jugador[]
  entrenadores Entrenadores[] @relation("ClasesToEntrenadores")
}

model JornadaClase {
  jornadaId   Int
  claseId     String
  asistencias Asistencia[]
  clase       Clases               @relation(fields: [claseId], references: [idClase], onDelete: Cascade)
  jornada     JornadaEntrenamiento @relation(fields: [jornadaId], references: [idJornadaEntrenamiento], onDelete: Cascade)

  @@id([jornadaId, claseId])
}

model Asistencia {
  jugadorId             String
  claseId               String
  fecha                 DateTime     @default(now())
  id                    Int          @id @default(autoincrement())
  asistencia            Boolean      @default(false)
  asistenciaJustificada Boolean      @default(false)
  partidoProgramado     Boolean      @default(false)
  jornadaId             Int
  clase                 Clases       @relation(fields: [claseId], references: [idClase], onDelete: Cascade)
  jornadaClase          JornadaClase @relation(fields: [jornadaId, claseId], references: [jornadaId, claseId], onDelete: Cascade)
  alumno                jugador      @relation(fields: [jugadorId], references: [playerId])

  @@unique([jugadorId, jornadaId, claseId])
}

model Temporadas {
  idPeriodo            Int      @id @default(autoincrement())
  Estado               Boolean  @default(false)
  Temporada            String   @unique
  fechaFinTemporada    DateTime
  bitacora             String?
  fechaInicioTemporada DateTime
}

model socio {
  id             String        @id @unique
  firstName      String
  lastName       String
  secondLastName String?
  street         String
  streetNumber   String
  colonia        String
  postalCode     String
  city           String
  state          String
  phoneNumber    String?
  email          String?
  urlSocioPhoto  String?
  urlSocioIne    String?
  urlIdDomicilio String?
  periodoDePago  String?
  rol            Role          @default(socio)
  status         StatusSocios  @default(Activo)
  fechaRegistro  DateTime      @default(now())
  estadoCuenta   estadoCuenta?
  familiares     familiares[]
  jugador        jugador[]
  usuarios       Usuario[]
}

enum RolUsuario {
  SuperAdmin
  Admin
  Entrenador
  Socio
}

model Mensualidad {
  idMensualidad       String               @id
  month               DateTime
  year                DateTime
  relacionMensualidad MensualidadJugador[]

  @@unique([year, month], name: "Mensualidad")
}

model MensualidadJugador {
  MensualidadId      String
  jugadorId          String
  estado             estadoMensualidad
  importeMensualidad Float
  saldoMensualidad   Float
  mensualidad        Mensualidad       @relation(fields: [MensualidadId], references: [idMensualidad])
  jugador            jugador           @relation(fields: [jugadorId], references: [playerId])

  @@id([MensualidadId, jugadorId])
}

model Parent {
  idParent             String       @id @default(cuid())
  parentFirstName      String
  parentLastName       String
  parentSecondLastName String?
  parentPhoneNumber    String       @unique
  parentEmail          String       @unique
  parentRelationship   String
  parentStatus         StatusSocios @default(PreRegistro)
  parentCurp           String       @unique
}

model player {
  playerId             String         @id @unique @default(cuid())
  playerFechaRegistro  DateTime       @default(now())
  playerFirstName      String
  playerLastName       String
  playerSecondLastName String?
  categoriaId          Int
  playerStatus         Status_Jugador @default(PreRegistro)
  playerGender         Gender
  categoria            Categorias     @relation(fields: [categoriaId], references: [idCategoria])
}

model jugador {
  playerId             String               @id @unique
  playerFechaRegistro  DateTime             @default(now())
  playerFirstName      String
  playerLastName       String
  playerSecondLastName String?
  categoria            String
  status               Status_Jugador       @default(activo)
  rama                 String
  socioId              String
  fechaNacimiento      DateTime
  playerPhotoUrl       String?
  playerCellPhone      String?
  playerEmail          String?
  ciudadNacimiento     String
  estadoNacimiento     String
  paisNacimiento       String
  schoolarLevel        String
  schoolarGrade        String
  school               String
  clasesIdClase        String?
  faltasCount          Int                  @default(0)
  categoriaId          Int?
  Asistencias          Asistencia[]
  mensualidad          MensualidadJugador[]
  estadoCuentaJugador  estadoCuentaJugador?
  Categorias           Categorias?          @relation(fields: [categoriaId], references: [idCategoria])
  clase                Clases?              @relation(fields: [clasesIdClase], references: [idClase])
  socio                socio                @relation(fields: [socioId], references: [id])
}

model familiares {
  familyId             String  @id @default(cuid())
  familyFirstName      String
  familyLastName       String
  familySecondLastName String?
  familyPhoneNumber    String
  familyRelationship   String
  socioId              String
  socio                socio   @relation(fields: [socioId], references: [id])
}

model Entrenadores {
  coachFirstName      String
  coachLastName       String
  coachSecondLastName String
  coachCellPhone      String?
  coachEmailPhone     String?
  coachId             Int       @id @unique @default(autoincrement())
  coachBirthDate      DateTime?
  clases              Clases[]  @relation("ClasesToEntrenadores")
}

model estadoCuenta {
  estadoCuentaId String              @id @unique @default(cuid())
  periodoPago    periodoDePago       @default(periodo3)
  balance        Float               @default(0)
  socioId        String              @unique
  movimientos    MovimientosEdoCta[]
  socio          socio               @relation(fields: [socioId], references: [id])
}

model MovimientosEdoCta {
  idMovimientoEdoCta    String               @id @unique @default(cuid())
  fechaMovimiento       DateTime
  concepto              String
  importe               Float
  tipoMovimiento        TipoMovimiento
  estadoCuentaId        String?
  estadoCuentaJugadorId String?
  conceptoMovimiento    conceptosMovimientos @relation(fields: [concepto], references: [idConceptoMovimiento])
  estadoCuenta          estadoCuenta?        @relation(fields: [estadoCuentaId], references: [estadoCuentaId])
  estadoCuentaJugador   estadoCuentaJugador? @relation(fields: [estadoCuentaJugadorId], references: [idEstadoCuentaJugador])
}

model conceptosMovimientos {
  idConceptoMovimiento String              @id @unique @default(cuid())
  concepto             String
  tipoConcepto         TipoConcepto
  movimientos          MovimientosEdoCta[]
}

model estadoCuentaJugador {
  idEstadoCuentaJugador String              @id @unique @default(cuid())
  importeMensualidad    Float
  tipoMensualidad       Cuota
  idJugadorEstadoCuenta String              @unique
  movimientos           MovimientosEdoCta[]
  jugador               jugador             @relation(fields: [idJugadorEstadoCuenta], references: [playerId])
}

model Categorias {
  idCategoria Int       @id @unique
  estado      Boolean   @default(true)
  jugador     jugador[]
  player      player[]
}

model Torneos {
  idTorneo        Int               @id @default(autoincrement())
  equiposEnTorneo equiposEnTorneo[]
  partidosTorneo  partidosTorneo[]
}

model equiposEnTorneo {
  idEquipoEnTorneo Int     @id @default(autoincrement())
  torneoId         Int
  equipo           String
  Torneos          Torneos @relation(fields: [torneoId], references: [idTorneo])
}

model partidosTorneo {
  idPartido Int     @id @default(autoincrement())
  torneoId  Int
  Torneos   Torneos @relation(fields: [torneoId], references: [idTorneo])
}

enum Gender {
  Varonil
  Femenil
  NoBinario
}

enum estadoMensualidad {
  pendiente
  pagada
  vencida
  acreditada
}

enum TipoConcepto {
  Mensualidad
  Uniformes
  Torneos
  Festejos
  Inscripciones
  Transportes
  Patrocinio
  Donativo
}

enum TipoClase {
  fut1
  fut3
  fut5
  fut7
  fut9
  fut11
}

enum EstadoJornada {
  Programada
  Cancelada
  Realizada
  Desarrollo
}

enum StatusSocios {
  Activo
  Ausente
  Baja
  vetado
  PreRegistro
}

enum Role {
  socio
  jugador
  entrenador
  admin
}

enum Cuota {
  Estandar
  Hermano_Menor
  Preferencial
  Cortesia
  Vip
  NoAplica
}

enum Status_Jugador {
  activo
  ausente
  baja
  lesionado
  vetado
  PreRegistro
}

enum periodoDePago {
  periodo1
  periodo2
  periodo3
}

enum TipoMovimiento {
  Cargo
  Abono
  Descuento
  Multa
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
