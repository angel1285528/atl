generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model JornadaEntrenamiento {
  idJornadaEntrenamiento    Int            @id @default(autoincrement())
  fechaJornadaEntrenamiento DateTime
  horaInicioJornada         String?        @default("18:00:00")
  horaFinJornada            String?        @default("20:00:00")
  bitacoraJornada           String?
  estado                    EstadoJornada  @default(Programada)
  lugarJornada              String?
  clases                    JornadaClase[]
}

model Clases {
  idClase      String         @id @unique
  tipo         TipoClase
  asistencias  Asistencia[]
  jornadas     JornadaClase[]
  alumnos      jugador[]
  entrenadores Entrenadores[] @relation("ClasesToEntrenadores")
}

model JornadaClase {
  jornadaId   Int
  claseId     String
  asistencias Asistencia[]
  clase       Clases               @relation(fields: [claseId], references: [idClase], onDelete: Cascade)
  jornada     JornadaEntrenamiento @relation(fields: [jornadaId], references: [idJornadaEntrenamiento], onDelete: Cascade)

  @@id([jornadaId, claseId])
}

model Asistencia {
  jugadorId             String
  claseId               String
  fecha                 DateTime     @default(now())
  id                    Int          @id @default(autoincrement())
  asistencia            Boolean      @default(false)
  asistenciaJustificada Boolean      @default(false)
  partidoProgramado     Boolean      @default(false)
  jornadaId             Int
  clase                 Clases       @relation(fields: [claseId], references: [idClase], onDelete: Cascade)
  jornadaClase          JornadaClase @relation(fields: [jornadaId, claseId], references: [jornadaId, claseId], onDelete: Cascade)
  alumno                jugador      @relation(fields: [jugadorId], references: [playerId])

  @@unique([jugadorId, jornadaId, claseId])
}

model Temporadas {
  idPeriodo            Int      @id @default(autoincrement())
  Estado               Boolean  @default(false)
  Temporada            String   @unique
  fechaFinTemporada    DateTime
  bitacora             String?
  fechaInicioTemporada DateTime
}

model socio {
  id             String        @id @unique
  firstName      String
  lastName       String
  secondLastName String?
  street         String
  streetNumber   String
  colonia        String
  postalCode     String
  city           String
  state          String
  phoneNumber    String?
  email          String?
  urlSocioPhoto  String?
  urlSocioIne    String?
  urlIdDomicilio String?
  periodoDePago  String?
  rol            Role          @default(socio)
  status         StatusSocios  @default(Activo)
  fechaRegistro  DateTime      @default(now())
  familiares     familiares[]
  jugador        jugador[]
  estadoCuenta   estadoCuenta?
}

model Mensualidad {
  idMensualidad       Int                  @id
  month               DateTime
  year                DateTime
  relacionMensualidad MensualidadJugador[]

  @@unique(name: "Mensualidad", fields: [year, month])
}

model MensualidadJugador {
  mensualidad        Mensualidad       @relation(fields: [MensualidadId], references: [idMensualidad])
  MensualidadId      Int
  jugador            jugador           @relation(fields: [jugadorId], references: [playerId])
  jugadorId          String
  estado             estadoMensualidad
  importeMensualidad Float
  saldoMensualidad   Float

  @@id([MensualidadId, jugadorId])
}

enum estadoMensualidad {
  pendiente
  pagada
  vencida
  acreditada
}

model jugador {
  playerId             String               @id @unique
  playerFechaRegistro  DateTime             @default(now())
  playerFirstName      String
  playerLastName       String
  playerSecondLastName String?
  categoria            String
  status               Status_Jugador       @default(activo)
  rama                 String
  socioId              String
  socio                socio                @relation(fields: [socioId], references: [id])
  fechaNacimiento      DateTime
  playerPhotoUrl       String?
  playerCellPhone      String?
  playerEmail          String?
  paisNacimiento       String
  estadoNacimiento     String
  ciudadNacimiento     String
  schoolarLevel        String
  schoolarGrade        String
  school               String
  Asistencias          Asistencia[]
  clase                Clases?              @relation(references: [idClase], fields: [clasesIdClase])
  estadoCuentaJugador  estadoCuentaJugador? // Relación con el modelo estadoCuentaJugador
  clasesIdClase        String?
  faltasCount          Int                  @default(0)
  mensualidad          MensualidadJugador[]
}

model familiares {
  familyId             String  @id @default(cuid())
  familyFirstName      String
  familyLastName       String
  familySecondLastName String?
  familyPhoneNumber    String
  familyRelationship   String
  socioId              String
  socio                socio   @relation(fields: [socioId], references: [id])
}

model Entrenadores {
  coachFirstName      String
  coachLastName       String
  coachSecondLastName String
  coachBirthDate      DateTime?
  coachCellPhone      String?
  coachEmailPhone     String?
  coachId             Int       @id @unique @default(autoincrement())
  clases              Clases[]  @relation("ClasesToEntrenadores")
}

model estadoCuenta {
  estadoCuentaId String              @id @unique @default(cuid())
  periodoPago    periodoDePago       @default(periodo3)
  balance        Float               @default(0)
  movimientos    MovimientosEdoCta[]
  socio          socio               @relation(fields: [socioId], references: [id])
  socioId        String              @unique
}

model MovimientosEdoCta {
  idMovimientoEdoCta    String               @id @unique @default(cuid())
  fechaMovimiento       DateTime
  conceptoMovimiento    conceptosMovimientos @relation(fields: [concepto], references: [idConceptoMovimiento])
  concepto              String
  importe               Float
  tipoMovimiento        TipoMovimiento
  estadoCuentaId        String?
  estadoCuenta          estadoCuenta?        @relation(fields: [estadoCuentaId], references: [estadoCuentaId])
  estadoCuentaJugadorId String?
  estadoCuentaJugador   estadoCuentaJugador? @relation(fields: [estadoCuentaJugadorId], references: [idEstadoCuentaJugador])
}

model conceptosMovimientos {
  idConceptoMovimiento String              @id @unique @default(cuid())
  concepto             String
  movimientos          MovimientosEdoCta[]
  tipoConcepto         TipoConcepto
}

enum TipoConcepto {
  Mensualidad
  Uniformes
  Torneos
  Festejos
  Inscripciones
  Transportes
  Patrocinio
  Donativo
}

model estadoCuentaJugador {
  idEstadoCuentaJugador String              @id @unique @default(cuid())
  importeMensualidad    Float
  tipoMensualidad       Cuota
  idJugadorEstadoCuenta String              @unique
  jugador               jugador             @relation(fields: [idJugadorEstadoCuenta], references: [playerId])
  movimientos           MovimientosEdoCta[]
}

model Categorias {
  idCategoria Int    @id @unique
  categoria   String @unique
}

enum TipoClase {
  fut1
  fut3
  fut5
  fut7
  fut9
  fut11
}

enum EstadoJornada {
  Programada
  Cancelada
  Realizada
  Desarrollo
}

enum StatusSocios {
  Activo
  Ausente
  Baja
}

enum Role {
  socio
  jugador
  entrenador
  admin
}

enum Cuota {
  Estandar
  Hermano_Menor
  Preferencial
  Vip
  Cortesia
  NoAplica
  //fuerzasBasicas
}

enum Status_Jugador {
  activo
  ausente
  baja
  lesionado
  vetado
}

enum periodoDePago {
  periodo1
  periodo2
  periodo3
}

model periodoCompetitivo {
  idPeriodo          Int       @id @default(autoincrement())
  periodo            String
  fechaiIncioPeriodo DateTime?
  fechaFinPeriodo    DateTime?
}

enum TipoMovimiento {
  Cargo
  Abono
  Descuento
  Multa
}

// -----------------------------------------------------------------------------
// Nueva arquitectura
// Las tablas anteriores se conservan temporalmente para no destruir información
// histórica. Todo desarrollo nuevo debe utilizar los modelos siguientes.
// -----------------------------------------------------------------------------

model User {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  role          String?
  banned        Boolean?    @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  membresias    Membresia[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Organizacion {
  id          String             @id @default(cuid())
  nombre      String
  slug        String             @unique
  estado      EstadoOrganizacion @default(ACTIVA)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  personas    Persona[]
  familias    Familia[]
  membresias  Membresia[]
  direcciones Direccion[]

  @@map("organizaciones")
}

model Membresia {
  id             String          @id @default(cuid())
  organizacionId String
  userId         String
  personaId      String?         @unique
  rol            RolMembresia
  estado         EstadoMembresia @default(ACTIVA)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona        Persona?        @relation(fields: [personaId], references: [id], onDelete: SetNull)

  @@unique([organizacionId, userId])
  @@index([organizacionId, rol])
  @@map("membresias")
}

model Persona {
  id               String             @id @default(cuid())
  organizacionId   String
  nombres          String
  apellidoPaterno  String?
  apellidoMaterno  String?
  fechaNacimiento  DateTime?          @db.Date
  sexo             String?
  nacionalidad     String?
  curpCifrada      String?            @db.Text
  curpBusquedaHash String?
  estado           EstadoPersona      @default(ACTIVA)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organizacion     Organizacion       @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  membresia        Membresia?
  socio            Socio?
  jugador          Jugador?
  entrenador       Entrenador?
  auxiliar         Auxiliar?
  telefonos        PersonaTelefono[]
  emails           PersonaEmail[]
  direcciones      PersonaDireccion[]
  familias         FamiliaMiembro[]

  @@unique([organizacionId, curpBusquedaHash])
  @@index([organizacionId, apellidoPaterno, apellidoMaterno, nombres])
  @@map("personas")
}

model PersonaTelefono {
  id         String       @id @default(cuid())
  personaId  String
  tipo       TipoContacto @default(MOVIL)
  codigoPais String       @default("+52")
  numero     String
  extension  String?
  principal  Boolean      @default(false)
  verificado Boolean      @default(false)
  persona    Persona      @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, codigoPais, numero])
  @@index([personaId, principal])
  @@map("persona_telefonos")
}

model PersonaEmail {
  id         String       @id @default(cuid())
  personaId  String
  tipo       TipoContacto @default(PERSONAL)
  email      String
  principal  Boolean      @default(false)
  verificado Boolean      @default(false)
  persona    Persona      @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, email])
  @@index([personaId, principal])
  @@map("persona_emails")
}

model Direccion {
  id                  String             @id @default(cuid())
  organizacionId      String
  googlePlaceId       String?
  direccionFormateada String?
  regionCode          String             @default("MX")
  languageCode        String?            @default("es-MX")
  codigoPostal        String?
  areaAdministrativa  String?
  localidad           String?
  sublocalidad        String?
  lineaDireccion1     String
  lineaDireccion2     String?
  latitud             Decimal?           @db.Decimal(10, 7)
  longitud            Decimal?           @db.Decimal(10, 7)
  plusCode            String?
  fuente              FuenteDireccion    @default(MANUAL)
  validadaAt          DateTime?
  googleFetchedAt     DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  organizacion        Organizacion       @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  personas            PersonaDireccion[]
  familias            FamiliaDireccion[]

  @@index([organizacionId, googlePlaceId])
  @@index([organizacionId, codigoPostal])
  @@map("direcciones")
}

model PersonaDireccion {
  id          String        @id @default(cuid())
  personaId   String
  direccionId String
  tipo        TipoDireccion @default(CASA)
  principal   Boolean       @default(false)
  fechaInicio DateTime      @default(now()) @db.Date
  fechaFin    DateTime?     @db.Date
  persona     Persona       @relation(fields: [personaId], references: [id], onDelete: Cascade)
  direccion   Direccion     @relation(fields: [direccionId], references: [id], onDelete: Cascade)

  @@unique([personaId, direccionId, tipo])
  @@index([personaId, principal])
  @@map("persona_direcciones")
}

model Familia {
  id             String             @id @default(cuid())
  organizacionId String
  codigoFamilia  String
  nombreFamilia  String
  estado         EstadoFamilia      @default(ACTIVA)
  fechaRegistro  DateTime           @default(now()) @db.Date
  observaciones  String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organizacion   Organizacion       @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  miembros       FamiliaMiembro[]
  direcciones    FamiliaDireccion[]

  @@unique([organizacionId, codigoFamilia])
  @@index([organizacionId, nombreFamilia])
  @@map("familias")
}

model FamiliaMiembro {
  id                      String             @id @default(cuid())
  familiaId               String
  personaId               String
  tipoMiembro             TipoMiembroFamilia
  parentesco              String?
  esTutorLegal            Boolean            @default(false)
  esResponsablePrincipal  Boolean            @default(false)
  esResponsableFinanciero Boolean            @default(false)
  autorizadoRecoger       Boolean            @default(false)
  autorizadoEmergencias   Boolean            @default(false)
  recibeNotificaciones    Boolean            @default(false)
  fechaInicio             DateTime           @default(now()) @db.Date
  fechaFin                DateTime?          @db.Date
  familia                 Familia            @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  persona                 Persona            @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([familiaId, personaId])
  @@index([personaId])
  @@map("familia_miembros")
}

model FamiliaDireccion {
  id          String        @id @default(cuid())
  familiaId   String
  direccionId String
  tipo        TipoDireccion @default(CASA)
  principal   Boolean       @default(false)
  familia     Familia       @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  direccion   Direccion     @relation(fields: [direccionId], references: [id], onDelete: Cascade)

  @@unique([familiaId, direccionId, tipo])
  @@index([familiaId, principal])
  @@map("familia_direcciones")
}

model Socio {
  id          String      @id @default(cuid())
  personaId   String      @unique
  numeroSocio String      @unique
  fechaAlta   DateTime    @default(now()) @db.Date
  fechaBaja   DateTime?   @db.Date
  estado      EstadoSocio @default(ACTIVO)
  tipo        TipoSocio   @default(REGULAR)
  persona     Persona     @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@map("socios_nuevo")
}

model Jugador {
  id              String        @id @default(cuid())
  personaId       String        @unique
  numeroJugador   String        @unique
  fechaIngreso    DateTime      @default(now()) @db.Date
  estadoDeportivo EstadoJugador @default(ACTIVO)
  posicion        String?
  dorsal          Int?
  persona         Persona       @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@map("jugadores_nuevo")
}

model Entrenador {
  id                    String        @id @default(cuid())
  personaId             String        @unique
  numeroEmpleado        String        @unique
  especialidad          String?
  numeroCertificacion   String?
  vigenciaCertificacion DateTime?     @db.Date
  estadoLaboral         EstadoLaboral @default(ACTIVO)
  persona               Persona       @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@map("entrenadores_nuevo")
}

model Auxiliar {
  id             String        @id @default(cuid())
  personaId      String        @unique
  numeroEmpleado String        @unique
  tipoAuxiliar   String?
  estadoLaboral  EstadoLaboral @default(ACTIVO)
  persona        Persona       @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@map("auxiliares")
}

enum EstadoOrganizacion {
  ACTIVA
  SUSPENDIDA
  INACTIVA
}

enum RolMembresia {
  ADMIN
  ENTRENADOR
  AUXILIAR
  TUTOR
  JUGADOR
}

enum EstadoMembresia {
  INVITADA
  ACTIVA
  SUSPENDIDA
  REVOCADA
}

enum EstadoPersona {
  ACTIVA
  INACTIVA
  BLOQUEADA
}

enum TipoContacto {
  PERSONAL
  TRABAJO
  CASA
  MOVIL
  EMERGENCIA
  OTRO
}

enum TipoDireccion {
  CASA
  TRABAJO
  FISCAL
  OTRO
}

enum FuenteDireccion {
  MANUAL
  GOOGLE_PLACES
  GOOGLE_ADDRESS_VALIDATION
}

enum EstadoFamilia {
  ACTIVA
  INACTIVA
  ARCHIVADA
}

enum TipoMiembroFamilia {
  SOCIO
  TUTOR
  JUGADOR
  CONTACTO_AUTORIZADO
  OTRO
}

enum EstadoSocio {
  ACTIVO
  SUSPENDIDO
  BAJA
}

enum TipoSocio {
  REGULAR
  HONORARIO
  BECADO
}

enum EstadoJugador {
  ACTIVO
  AUSENTE
  BAJA
  LESIONADO
  VETADO
}

enum EstadoLaboral {
  ACTIVO
  LICENCIA
  SUSPENDIDO
  BAJA
}
