{
  "name": "gestion-atl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:dev:up": "docker compose -f compose.dev.yml up -d",
    "db:dev:down": "docker compose -f compose.dev.yml down",
    "db:dev:status": "docker compose -f compose.dev.yml ps",
    "db:migrate": "prisma migrate deploy",
    "auth:create-user": "npx auth@1.7.7 create-admin --config lib/auth.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "better-auth": "1.7.7",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.12.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.30",
    "source-map-js": "1.2.2"
  }
}
